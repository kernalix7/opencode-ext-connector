{
  "name": "opencode-ext-connector",
  "version": "0.9.0",
  "description": "External provider connector for OpenCode",
  "type": "module",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kernalix7/opencode-ext-connector.git"
  },
  "homepage": "https://github.com/kernalix7/opencode-ext-connector#readme",
  "bugs": {
    "url": "https://github.com/kernalix7/opencode-ext-connector/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./xai": {
      "types": "./dist/xai.d.ts",
      "import": "./dist/xai.js"
    },
    "./claude": {
      "types": "./dist/sdk/claude.d.ts",
      "import": "./dist/sdk/claude.js"
    },
    "./command-code": {
      "types": "./dist/sdk/command-code.d.ts",
      "import": "./dist/sdk/command-code.js"
    },
    "./cursor": {
      "types": "./dist/sdk/cursor.d.ts",
      "import": "./dist/sdk/cursor.js"
    },
    "./ollama": {
      "types": "./dist/sdk/ollama.d.ts",
      "import": "./dist/sdk/ollama.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "docs/README.ko.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "check": "bun run lint && bun run typecheck && bun run check:policy && bun run check:loc && bun run test:foundation",
    "check:loc": "bun run scripts/check-file-size.ts",
    "check:policy": "bun run scripts/check-source-policy.ts",
    "clean": "rm -rf dist",
    "lint": "biome check .",
    "test": "bun test",
    "test:e2e": "bun test tests/e2e/opencode-legacy-loader.test.ts tests/e2e/opencode-provider-lifecycle.test.ts tests/e2e/ollama-lifecycle.test.ts tests/e2e/opencode-package-install.test.ts",
    "test:e2e:v2": "OPENCODE_V2_BIN=${OPENCODE_V2_BIN:-opencode2} bun test tests/e2e/opencode-v2-harness.test.ts tests/e2e/opencode-v2-empty.test.ts tests/e2e/opencode-v2-ollama.test.ts",
    "test:foundation": "bun test tests/unit/scripts",
    "test:integration": "bun test tests/integration",
    "test:provider": "bun test tests/unit/providers",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "bun run build",
    "verify:package": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.127",
    "@ai-sdk/openai": "3.0.123",
    "@ai-sdk/provider": "3.0.18",
    "@opencode-ai/plugin": "1.18.18",
    "@opencode/plugin": "2.0.20",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "1.3.14",
    "typescript": "6.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
