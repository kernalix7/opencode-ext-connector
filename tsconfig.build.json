{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "isolatedDeclarations": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "src/index.ts",
    "src/v2.ts",
    "src/v2-entry/server.ts",
    "src/xai.ts",
    "src/sdk/*.ts",
    "src/opencode/v2-sdk.ts"
  ],
  "exclude": ["dist", "node_modules", "scripts", "tests"]
}
